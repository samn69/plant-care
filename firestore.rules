rules_version = '2';
// Plant Care: who may read and change a home and its plants.
// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // a person may only write their own entry in the names map
    function onlyMyName() {
      return !('names' in changed()) || request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()]);
    }

    // each person's reminder settings and phones; only they can see them (the reminder job reads them as admin)
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /homes/{homeId} {
      allow read: if signedIn() && (uid() in resource.data.members || (verified() && email() in resource.data.invites));

      allow create: if signedIn()
        && request.resource.data.owner == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.invites == [];

      // the person who created it: invite, rename, remove people (cannot hand it over or leave it)
      allow update: if signedIn() && resource.data.owner == uid()
        && request.resource.data.owner == uid()
        && uid() in request.resource.data.members;

      // members: the shared room climate and their own name
      allow update: if signedIn() && uid() in resource.data.members
        && changed().hasOnly(['climate', 'names']) && onlyMyName();

      // a member leaves
      allow update: if signedIn() && uid() in resource.data.members && resource.data.owner != uid()
        && changed().hasOnly(['members', 'names']) && onlyMyName()
        && request.resource.data.members.toSet() == resource.data.members.toSet().difference([uid()].toSet());

      // an invited person joins (adds themselves) or declines (only removes the invitation)
      allow update: if verified() && email() in resource.data.invites
        && changed().hasOnly(['members', 'invites', 'names']) && onlyMyName()
        && request.resource.data.invites.toSet() == resource.data.invites.toSet().difference([email()].toSet())
        && (request.resource.data.members.toSet() == resource.data.members.toSet().union([uid()].toSet())
            || request.resource.data.members == resource.data.members);

      allow delete: if signedIn() && resource.data.owner == uid();

      match /plants/{plantId} {
        allow read, write: if signedIn()
          && uid() in get(/databases/$(database)/documents/homes/$(homeId)).data.members;
      }
    }
  }
}
